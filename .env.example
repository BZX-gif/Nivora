# NIVORA — environment variables (production only; none required for the demo)
# Copy to .env.local and fill in when connecting a backend. Never commit real secrets.

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/nivora

# Auth (NextAuth or equivalent)
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=https://your-domain.example

# Map tiles (demo uses keyless OpenStreetMap; a keyed provider needs a key here)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Managed image storage
IMAGE_STORAGE_BUCKET=

# Public site URL (metadata, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
